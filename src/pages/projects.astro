---
import Layout from '../layouts/Layout.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import { getCollection } from 'astro:content';

const media = (await getCollection('media')).sort(
	(a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0)
);
---

<Layout title="Portfolio" description="Selected work in college access strategy, data architecture, research partnerships, and organizational transformation.">
	<div class="mx-auto max-w-7xl px-6 py-16 lg:px-8 lg:py-24">
		<h1 class="text-h1 mb-16 font-semibold text-neutral-900">
			Portfolio
		</h1>

		<ProjectGrid />

		<section class="mt-24 border-t border-neutral-200 pt-16">
			<h2 class="text-h2 mb-12 font-semibold text-neutral-900">
				Selected Media & Commentary
			</h2>
			<div class="grid grid-cols-1 gap-6 md:grid-cols-2">
				{media.map((item) => (
					<a
						href={item.data.url}
						target="_blank"
						rel="noopener noreferrer"
						class="group block rounded-lg border border-neutral-200 p-6 transition-all hover:border-primary/50 hover:shadow-sm"
					>
						<strong class="mb-1 block text-sm font-semibold text-neutral-900">{item.data.outlet}</strong>
						<span class="text-base text-neutral-600 transition-colors group-hover:text-primary">
							{item.data.title} <span aria-hidden="true">↗</span>
						</span>
					</a>
				))}
			</div>
		</section>
	</div>
</Layout>
