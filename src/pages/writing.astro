---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const fmt = (d) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long' });
---

<Layout title="Perspectives" description="Thoughts on strategy, data, and building systems for change in education and nonprofits.">
	<main class="mx-auto max-w-5xl px-6 py-16 lg:px-8 lg:py-24">
		<div class="mb-16">
			<h1 class="mb-6 text-4xl font-semibold leading-tight text-neutral-900 sm:text-5xl lg:text-6xl">
				Perspectives
			</h1>
			<p class="text-lg leading-relaxed text-neutral-700 sm:text-xl">
				Thoughts on strategy, data, and building systems for change wherever you are.
			</p>
		</div>

		<div class="space-y-12 border-t border-neutral-200 pt-12">
			{posts.map((post) => (
				<article class="group">
					<a
						href={post.data.externalUrl ?? `/writing/${post.id}`}
						class="block transition-colors hover:text-primary"
					>
						<time class="mb-2 block text-sm font-medium text-neutral-500">
							{fmt(post.data.date)}
						</time>
						<h2 class="mb-4 text-2xl font-semibold text-neutral-900 sm:text-3xl group-hover:text-primary transition-colors">
							{post.data.title}
						</h2>
						<p class="text-base leading-relaxed text-neutral-700 sm:text-lg">
							{post.data.description}
						</p>
					</a>
				</article>
			))}
		</div>
	</main>
</Layout>
