---
import Layout from './Layout.astro';

interface Props {
	title: string;
	date: string;
	excerpt?: string;
	pubDate?: Date;
}

const { title, date, excerpt, pubDate } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const articleSchema = pubDate
	? {
			"@context": "https://schema.org",
			"@type": "Article",
			headline: title,
			description: excerpt,
			datePublished: pubDate.toISOString(),
			author: { "@type": "Person", name: "Preston Magouirk", url: Astro.site?.href },
			publisher: { "@type": "Person", name: "Preston Magouirk" },
			mainEntityOfPage: canonicalURL.href,
		}
	: null;
---

<Layout title={title} description={excerpt}>
	{articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}
	<main class="mx-auto max-w-3xl px-6 py-16 lg:px-8 lg:py-24">
		<article>
			<header class="mb-12">
				<time class="mb-4 block text-sm font-medium text-neutral-600">
					{date}
				</time>
				<h1 class="mb-6 text-4xl font-semibold leading-tight text-neutral-900 sm:text-5xl lg:text-6xl">
					{title}
				</h1>
				{excerpt && (
					<p class="text-lg leading-relaxed text-neutral-700 sm:text-xl">
						{excerpt}
					</p>
				)}
			</header>

			<div class="blog-content">
				<slot />
			</div>

			<footer class="mt-16 space-y-8 border-t border-neutral-200 pt-8">
				<a
					href="/writing"
					class="inline-flex items-center text-base font-semibold text-primary hover:text-primary/80 transition-colors"
				>
					<svg
						class="mr-2 h-4 w-4"
						fill="none"
						stroke="currentColor"
						viewBox="0 0 24 24"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="M15 19l-7-7 7-7"
						></path>
					</svg>
					Back to Perspectives
				</a>

				<div class="border-t border-neutral-200 pt-8">
					<p class="mb-4 text-base font-semibold text-neutral-900">
						Get in touch
					</p>
					<p class="mb-6 text-base leading-relaxed text-neutral-700">
						I'd love to hear your thoughts or discuss how these ideas might apply to your work.
					</p>
					<div class="flex flex-wrap items-center gap-6">
						<a
							href="https://calendly.com/preston-magouirk"
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center text-base font-medium text-primary hover:text-primary/80 transition-colors"
						>
							Schedule Time
						</a>
						<a
							href="mailto:pmagouir@gmail.com"
							class="inline-flex items-center text-base font-medium text-primary hover:text-primary/80 transition-colors"
						>
							Email
						</a>
						<a
							href="https://www.linkedin.com/in/preston-magouirk-840aa757/"
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center text-base font-medium text-primary hover:text-primary/80 transition-colors"
						>
							LinkedIn
						</a>
					</div>
				</div>
			</footer>
		</article>
	</main>
</Layout>

<style is:global>
	.blog-content {
		color: rgb(38 38 38);
		max-width: 65ch;
	}

	.blog-content p {
		margin-top: 1.5em;
		margin-bottom: 1.5em;
		line-height: 1.75;
		font-size: 1.125rem;
	}

	.blog-content p:first-child {
		margin-top: 0;
	}

	.blog-content h2 {
		margin-top: 3em;
		margin-bottom: 1em;
		font-size: 1.5em;
		font-weight: 700;
		line-height: 1.3;
		color: rgb(23 23 23);
		font-family: 'Lora', Georgia, serif;
	}

	.blog-content h2:first-of-type {
		margin-top: 3.5em;
	}

	.blog-content h2 + p {
		margin-top: 1em;
	}

	.blog-content strong {
		font-weight: 600;
		color: rgb(23 23 23);
	}

	.blog-content a {
		color: #1F3D2B;
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 2px;
	}

	.blog-content a:hover {
		color: #1F3D2B;
		opacity: 0.8;
	}
</style>

