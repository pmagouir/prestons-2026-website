---
// src/components/ProjectGrid.astro — renders project case studies from the
// `projects` content collection. Pass `limit` for a homepage preview.
import { getCollection } from 'astro:content';

interface Props {
	limit?: number;
}
const { limit } = Astro.props;

let projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
if (limit) projects = projects.slice(0, limit);

const statusLabel: Record<string, string> = {
	operational: 'Live',
	building: 'Building',
	completed: 'Prior',
};
---

<div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
	{projects.map((project) => {
		const p = project.data;
		const categories = [...new Set(p.links.map((l) => l.category ?? ''))];
		return (
			<article class="flex flex-col rounded-lg bg-white p-6 shadow-sm ring-1 ring-neutral-200 transition-all hover:shadow-md hover:ring-primary/20">
				<div class="mb-2 flex items-start justify-between gap-3">
					<p class="text-sm font-medium text-neutral-600">{p.context}</p>
					<span class="shrink-0 rounded-full border border-primary/15 bg-primary/5 px-2.5 py-0.5 text-xs font-medium text-primary">
						{statusLabel[p.status]}
					</span>
				</div>

				<h2 class="mb-4 text-2xl font-bold leading-tight text-neutral-900">{p.title}</h2>

				<p class="mb-4 text-sm leading-relaxed text-neutral-600">{p.summary}</p>

				<div class="mb-6 flex flex-wrap gap-2">
					{p.tags.map((tag) => (
						<span class="rounded-full border border-neutral-200 bg-neutral-100 px-3 py-1 text-xs font-medium text-neutral-700">
							{tag}
						</span>
					))}
				</div>

				{p.links.length > 0 && (
					<div class="mb-6 border-t border-neutral-100 pt-4">
						<p class="mb-3 text-xs font-semibold uppercase tracking-wide text-neutral-600">
							Key Artifacts
						</p>
						{categories.map((cat) => (
							<div class="mb-2">
								{cat && <p class="mb-1.5 text-xs font-semibold text-neutral-900">{cat}</p>}
								<ul class={cat ? 'ml-2 space-y-1.5 border-l-2 border-primary/20 pl-3' : 'space-y-1.5'}>
									{p.links.filter((l) => (l.category ?? '') === cat).map((l) => (
										<li>
											<a
												href={l.url}
												target="_blank"
												rel="noopener noreferrer"
												class="text-sm text-neutral-600 hover:text-primary hover:underline"
											>
												{l.label}
											</a>
										</li>
									))}
								</ul>
							</div>
						))}
					</div>
				)}

				{p.mainLink && (
					<a
						href={p.mainLink.url}
						target="_blank"
						rel="noopener noreferrer"
						class="mt-auto inline-flex w-full items-center justify-center rounded-lg bg-neutral-900 px-4 py-3 text-sm font-semibold text-white transition-all hover:bg-neutral-800 focus:outline-none focus:ring-2 focus:ring-neutral-900 focus:ring-offset-2"
					>
						{p.mainLink.label}
					</a>
				)}
			</article>
		);
	})}
</div>
