---
// Footer component with copyright and site/social links.
// Footer link state (M4 / Pattern 19 fix): default neutral-400 (7.6:1 on #0F0F0F);
// hover brightens to --color-footer-link-hover (#F1F5F2, 17.4:1) + underline.
const linkClass =
	"on-dark text-sm font-medium text-neutral-400 underline-offset-2 transition-colors duration-150 ease-out hover:text-[var(--color-footer-link-hover)] hover:underline";
---

<footer class="mt-auto border-t border-neutral-300/50 bg-neutral-900/95 text-neutral-400">
	<div class="mx-auto max-w-5xl px-6 py-8 lg:px-8">
		<div class="flex flex-col items-center justify-between gap-6 md:flex-row">
			<div>
				<p class="text-sm text-neutral-400">
					Strategy, data, and change management for mission-driven organizations.
				</p>
				<p class="mt-1 text-sm text-neutral-400">
					© 2026 Preston Magouirk
				</p>
			</div>

			<!-- Site / Social Links -->
			<div class="flex items-center gap-6">
				<a
					href="https://www.linkedin.com/in/preston-magouirk-840aa757/"
					target="_blank"
					rel="noopener noreferrer"
					class={linkClass}
					aria-label="LinkedIn"
				>
					LinkedIn
				</a>
				<a
					href="mailto:pmagouir@gmail.com"
					class={linkClass}
					aria-label="Email"
				>
					Email
				</a>
				<a
					href="/personal"
					class={linkClass}
				>
					Personal
				</a>
			</div>
		</div>
	</div>
</footer>
