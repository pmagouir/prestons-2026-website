---
// src/components/SkillsToolkit.astro
// Curated 2026-06-12 (m11): dropped "Stata" (untraceable in BRAIN) and
// "VS Code + Cursor" (junior on an executive register). Systems-level entries kept.

const skillCategories = [
    {
        title: "Data Science & Analysis",
        skills: [
            "R (tidyverse)",
            "Python (Pandas/NumPy)",
            "SQL",
            "Causal Inference",
            "Survey Design"
        ]
    },
    {
        title: "Engineering & Web",
        skills: [
            "Astro",
            "React",
            "Tailwind CSS",
            "Git / GitHub"
        ]
    },
    {
        title: "Platforms & Strategy",
        skills: [
            "Salesforce Education Cloud",
            "Tableau",
            "Financial Modeling",
            "Strategic Planning"
        ]
    },
    {
        title: "AI & Automation",
        skills: [
            "AI System Design",
            "Multi-Agent Orchestration",
            "Workflow Automation"
        ]
    }
];
---

<section class="border-t border-secondary/30 bg-background py-12">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mb-10 max-w-2xl">
            <h2 class="text-h2 font-semibold text-neutral-900">Technical Toolkit</h2>
            <p class="mt-2 text-body text-neutral-600">The languages, frameworks, and platforms I use to build systems.</p>
        </div>

        <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4">
            {skillCategories.map((category) => (
                <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-neutral-200">
                    <h3 class="text-label mb-4 font-semibold uppercase text-neutral-600">
                        {category.title}
                    </h3>
                    <ul class="flex flex-wrap gap-2">
                        {category.skills.map((skill) => (
                            <li class="inline-flex items-center rounded-md bg-neutral-100 px-2.5 py-1.5 text-sm font-medium text-neutral-700">
                                {skill}
                            </li>
                        ))}
                    </ul>
                </div>
            ))}
        </div>
    </div>
</section>
