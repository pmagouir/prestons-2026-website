---
// Navigation component with mobile hamburger menu
const currentPath = Astro.url.pathname;

// Four primary links (Fitness removed 2026-06-12; personal content is footer-reached).
const navLinks = [
	{ href: "/about", label: "About" },
	{ href: "/experience", label: "Experience" },
	{ href: "/projects", label: "Portfolio" },
	{ href: "/consulting", label: "Consulting" },
];

function isActive(href: string): boolean {
	if (href === "/") return currentPath === "/";
	return currentPath.startsWith(href);
}
---

<header class="sticky top-0 z-50 bg-white shadow-sm">
	<nav class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4 lg:px-8" aria-label="Primary">
		<!-- Name/Logo - acts as Home button -->
		<a
			href="/"
			class="text-lead font-bold tracking-[0.12em] text-neutral-900 transition-colors duration-150 ease-out hover:text-primary"
		>
			Preston Magouirk
		</a>

		<!-- Desktop Navigation Links -->
		<div class="hidden items-center gap-8 text-sm text-neutral-700 md:flex">
			{navLinks.map((link) => (
				<a
					href={link.href}
					aria-current={isActive(link.href) ? "page" : undefined}
					class:list={[
						"py-2 font-medium transition-colors duration-150 ease-out hover:text-primary",
						isActive(link.href)
							? "border-b-2 border-secondary pb-1 font-semibold text-secondary"
							: "text-neutral-700",
					]}
				>
					{link.label}
				</a>
			))}
		</div>

		<!-- Mobile Hamburger Button -->
		<button
			id="mobile-menu-button"
			class="flex flex-col gap-1.5 p-2 md:hidden"
			aria-label="Toggle menu"
			aria-expanded="false"
			aria-controls="mobile-menu"
		>
			<span
				id="hamburger-line-1"
				class="h-0.5 w-6 bg-neutral-900 transition-all duration-300"
			></span>
			<span
				id="hamburger-line-2"
				class="h-0.5 w-6 bg-neutral-900 transition-all duration-300"
			></span>
			<span
				id="hamburger-line-3"
				class="h-0.5 w-6 bg-neutral-900 transition-all duration-300"
			></span>
		</button>
	</nav>

	<!-- Mobile Menu (hidden by default) -->
	<div
		id="mobile-menu"
		class="hidden border-t border-neutral-200 bg-white md:hidden"
		data-open="false"
	>
		<div class="flex flex-col px-6 py-4">
			{navLinks.map((link) => (
				<a
					href={link.href}
					aria-current={isActive(link.href) ? "page" : undefined}
					class:list={[
						"py-3 text-sm transition-colors duration-150 ease-out hover:text-primary",
						isActive(link.href) ? "font-semibold text-secondary" : "text-neutral-700",
					]}
				>
					{link.label}
				</a>
			))}
		</div>
	</div>
</header>

<script>
	const menuButton = document.getElementById('mobile-menu-button');
	const mobileMenu = document.getElementById('mobile-menu');
	const line1 = document.getElementById('hamburger-line-1');
	const line2 = document.getElementById('hamburger-line-2');
	const line3 = document.getElementById('hamburger-line-3');

	function closeMenu() {
		if (!mobileMenu || !menuButton) return;
		mobileMenu.classList.add('hidden');
		mobileMenu.dataset.open = 'false';
		menuButton.setAttribute('aria-expanded', 'false');
		line1?.classList.remove('rotate-45', 'translate-y-2');
		line2?.classList.remove('opacity-0');
		line3?.classList.remove('-rotate-45', '-translate-y-2');
	}

	function openMenu() {
		if (!mobileMenu || !menuButton) return;
		mobileMenu.classList.remove('hidden');
		mobileMenu.dataset.open = 'true';
		menuButton.setAttribute('aria-expanded', 'true');
		line1?.classList.add('rotate-45', 'translate-y-2');
		line2?.classList.add('opacity-0');
		line3?.classList.add('-rotate-45', '-translate-y-2');
	}

	if (menuButton && mobileMenu) {
		menuButton.addEventListener('click', () => {
			const isOpen = mobileMenu.dataset.open === 'true';
			if (isOpen) closeMenu();
			else openMenu();
		});

		// Close menu when clicking a link
		mobileMenu.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => closeMenu());
		});

		// Escape closes the menu and returns focus to the toggle (m15)
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && mobileMenu.dataset.open === 'true') {
				closeMenu();
				menuButton.focus();
			}
		});
	}
</script>
